<Window x:Class="RevitWindDrivenRain.ComprehensiveInputForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environmental and Analysis Settings" Height="600" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Row for Visualization Style Selector -->
            <RowDefinition Height="Auto"/>
            <!-- New row for feedbackLabel -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Environmental and Analysis Settings Labels -->
        <Label Content="Height above section box top (m):" Grid.Row="0" Grid.Column="0" Margin="0,5,0,0"/>
        <Label Content="Wind Direction (degrees): eg. 67.5,90,22.5" Grid.Row="1" Grid.Column="0" Margin="0,5,0,0"/>
        <Label Content="Wind speed (m/s): eg 3.5,5,7.5" Grid.Row="2" Grid.Column="0" Margin="0,5,0,0"/>
        <Label Content="Raindrop radius (m):" Grid.Row="3" Grid.Column="0" Margin="0,5,0,0"/>
        <Label Content="Rainfall Intensity (mm/hr): eg 1,2,3" Grid.Row="4" Grid.Column="0" Margin="0,5,0,0"/>
        <Label Content="Simulation Time (minutes):" Grid.Row="5" Grid.Column="0" Margin="0,5,0,0"/>
        <Label Content="Grid Resolution (mm):" Grid.Row="6" Grid.Column="0" Margin="0,5,0,0"/>

        <!-- Environmental and Analysis Settings Input Fields -->
        <TextBox x:Name="heightTextBox" Grid.Row="0" Grid.Column="1" Margin="0,5,0,0"/>
        <TextBox x:Name="rotationAngleTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"/>
        <TextBox x:Name="windSpeedTextBox" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"/>
        <TextBox x:Name="raindropRadiusTextBox" Grid.Row="3" Grid.Column="1" Margin="0,5,0,0"/>
        <TextBox x:Name="rainfallIntensityTextBox" Grid.Row="4" Grid.Column="1" Margin="0,5,0,0"/>
        <TextBox x:Name="simulationTimeInMinutesTextBox" Grid.Row="5" Grid.Column="1" Margin="0,5,0,0"/>
        <TextBox x:Name="raySpacingTextBox" Grid.Row="6" Grid.Column="1" Margin="0,5,0,0"/>

        <!-- Environmental and Analysis Settings CheckBoxes -->
        <CheckBox x:Name="generateOriginalRaysCheckBox" Content="Generate original rays?" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,15,0,0"/>
        <CheckBox x:Name="generateAdditionalRaysCheckBox" Content="Generate additional rays?" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,5,0,0"/>

        <!-- Environmental and Analysis Settings RadioButtons -->
        <RadioButton x:Name="intersectionBasedRadioButton" Content="Ray-Intersection-Based Approach" Grid.Row="9" Grid.ColumnSpan="2" Margin="0,15,0,0"/>
        <RadioButton x:Name="gridBasedRadioButton" Content="ISO-WDR-Based Approach" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,5,0,0"/>

        <!-- Visualization Style Selector -->
        <Label Content="Visualization Style Selector" Grid.Row="12" Grid.ColumnSpan="2" Margin="0,10,0,0" FontWeight="Bold"/>
        <RadioButton x:Name="radioGradient" Content="Apply Gradient Style" GroupName="VisualizationStyle" Click="RadioButton_Checked" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0" Grid.Row="13" Grid.Column="0"/>
        <RadioButton x:Name="radioSolidColor" Content="Apply Solid Color Style" GroupName="VisualizationStyle" Click="RadioButton_Checked" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0" Grid.Row="13" Grid.Column="1"/>

        <!-- Feedback Label -->
        <Label x:Name="feedbackLabel" Grid.Row="14" Grid.ColumnSpan="2" Foreground="Red" Margin="0,5,0,0"/>

        <!-- Environmental and Analysis Settings Buttons -->
        <Button x:Name="okButton" Content="OK" Grid.Row="15" Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
        <Button x:Name="cancelButton" Content="Cancel" Grid.Row="15" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
    </Grid>
</Window>
