<Window x:Class="RevitWindDrivenRain.VisualizationStyleSelector"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualization Style Selector" Height="138" Width="339">
    <Grid Margin="0,0,-18,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="55*"/>
            <ColumnDefinition Width="62*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Button x:Name="btnGradient" Content="Apply Gradient Style" Click="btnGradient_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Margin="5,0,0,0" Height="25" Grid.Column="1"/>
        <Button x:Name="btnSolidColor" Content="Apply Solid Color Style" Click="btnSolidColor_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="25" Grid.Column="2" Margin="10,0,0,0"/>
        <!--<Button x:Name="btnDeleteStyles" Content="Delete All Styles" Click="btnDeleteStyles_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="59,64,0,0" Height="25" Grid.ColumnSpan="2" Grid.Column="1" Grid.RowSpan="2"/>-->
    </Grid>
</Window>